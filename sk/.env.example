# Example environment variables for development
# Copy this to .env and fill in your values

# OpenAI API Key (server-side only)
OPENAI_API_KEY=sk-...

# PocketBase admin credentials for type generation (server-side only)
PB_TYPEGEN_EMAIL=admin@example.com
PB_TYPEGEN_PASSWORD=your_admin_password

# PocketBase shared user password (server-side only)
# NOTE: This is a temporary solution - implement proper auth in production
PB_USER_PASSWORD=shared_password

# Public PocketBase URL (accessible to browser)
# Development: http://127.0.0.1:8090
# Production: https://pb.your-domain.com
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
